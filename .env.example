# Conversational and extraction models
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=enabled

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.6-plus
QWEN_VLM_MODEL=qwen3.6-flash
QWEN_VLM_ENABLE_THINKING=false

# Optional search and metadata services
ANYSEARCH_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Local or remote scientific microservices
MINERU_BASE_URL=http://127.0.0.1:18000
MINERU_OUTPUT_ROOT=runtime/mining_platform/mineru_external
DECIMER_SEGMENTATION_BASE_URL=http://127.0.0.1:18100
DECIMER_SMI_BASE_URL=http://127.0.0.1:18101

# Comma-separated origins allowed to call the API from a browser.
OPTOVLAB_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# Optional database browser URL used by apps/web.
VITE_DATABASE_URL=http://127.0.0.1:3000
